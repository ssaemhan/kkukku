{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "salary-kkukku",
  "version": "0.3.0",
  "description": "A Korean macOS widget that estimates earnings in real time from a monthly salary and work schedule.",
  "author": {
    "name": "saemhan",
    "email": "whosemi@gmail.com"
  },
  "homepage": "https://github.com/ssaemhan/kkukku",
  "repository": "https://github.com/ssaemhan/kkukku",
  "license": "MIT",
  "keywords": [
    "macos",
    "salary",
    "widget",
    "productivity"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Salary Kkukku",
        "shortDescription": "실시간 월급 카운터 위젯",
        "longDescription": "월급과 근무 요일·시간을 기준으로 이번 달 예상 누적 수입을 초 단위로 보여주는 macOS 꾸꾸 위젯입니다.",
        "developerName": "saemhan",
        "category": "Productivity",
        "capabilities": [
          "Interactive"
        ],
        "defaultPrompt": "Salary Kkukku를 설치하고 실행해줘.",
        "websiteURL": "https://github.com/ssaemhan/kkukku",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
